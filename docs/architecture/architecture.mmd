flowchart TB
    user(["Användare<br/>laddar upp CV, chattar, pratar"])

    subgraph gh["GitHub"]
        direction LR
        kanban["Kanban<br/>alla uppgifter"]
        repo["Repo<br/>main + feature-branches"]
        ci["Actions: CI<br/>ruff + pytest + evals"]
        cd["Actions: CD<br/>bygger Docker-images"]
        kanban -.-> repo
        repo --> ci --> cd
    end

    acr[("Azure Container Registry<br/>sparar images")]

    subgraph dockerfiles_box["Docker-filer"]
        direction LR
        dockerfiles["dockerfiles/<br/>backend.Dockerfile + frontend.Dockerfile"]
        compose["docker-compose.yaml<br/>startar båda containrarna lokalt"]
    end

    subgraph runtime["DOCKER: två containrar, lokalt och på Azure"]
        subgraph fe["frontend-container: cvoice_frontend, Streamlit :8501"]
            direction TB
            app["app.py<br/>st.navigation"]
            subgraph views["views/"]
                v_upload["upload.py"]
                v_profile["profile.py<br/>nyckeltal, jobbmeny, sammanfattning"]
                v_chat["chat.py"]
                v_voice["voice.py"]
                v_match["job_match.py"]
            end
            comps["components.py<br/>kpi_cards, chat_window"]
            client["api_client.py + constants.py<br/>alla HTTP-anrop, API_URL"]
            app --> views
            views --> comps
            views --> client
        end

        subgraph be["backend-container: cvoice_backend, FastAPI :8000"]
            direction TB
            api["api.py<br/>alla endpoints + Logfire-setup"]
            ingest["ingestion.py<br/>PDF till text, delar i bitar"]
            subgraph agents["agents/"]
                a_prof["profile_agent.py<br/>output: Profile"]
                a_pers["persona_agent.py<br/>verktyg: search_my_documents"]
                a_match["match_agent.py<br/>output: MatchResult"]
            end
            voicef["voice.py<br/>tal till text, text till tal"]
            vstore["vector_store.py<br/>lägger till och söker"]
            shared["model.py, data_models.py,<br/>constants.py, prompts.py"]
            lancedb[("knowledge_base/<br/>LanceDB, volym i Docker")]

            api --> ingest
            ingest --> a_prof
            ingest --> vstore
            api --> a_pers
            a_pers -->|"söker bara i rätt profil"| vstore
            api --> a_match
            a_match --> vstore
            api --> voicef
            vstore --> lancedb
            agents -.-> shared
        end
    end

    subgraph evalsbox["backend/evals/"]
        datasets["datasets/<br/>persona + injection"]
        run_evals["run_evals.py<br/>Pydantic Evals + LLMJudge"]
        datasets --> run_evals
    end

    subgraph ext["Externa tjänster"]
        nvidia["Nvidia Build<br/>språkmodell"]
        embapi["Cohere<br/>embedding, multilingual"]
        speech["Tal-API<br/>väljs senare"]
        logfire["Logfire<br/>traces, promptversioner, evals"]
    end

    user --> app
    client -->|"HTTP: JSON och filer"| api
    shared --> nvidia
    vstore --> embapi
    voicef --> speech
    api -.->|"traces"| logfire
    shared -.->|"hämtar prompter"| logfire
    run_evals --> a_pers
    run_evals -->|"LLMJudge"| nvidia
    run_evals -.->|"resultat"| logfire
    ci -.-> run_evals
    dockerfiles -->|"bygger"| fe
    dockerfiles -->|"bygger"| be
    compose -->|"startar"| runtime
    cd -.->|"använder"| dockerfiles
    cd -->|"pushar images"| acr
    acr -->|"startar containrar"| runtime

    style runtime stroke:#ffffff,stroke-width:3px,stroke-dasharray:8 4
