            direction TB
            app["app.py<br/>st.navigation"]
            subgraph views["views/"]
                v_upload["upload.py<br/>#3"]
                v_profile["profile.py<br/>#4 nyckeltal, jobbmeny, sammanfattning"]
                v_chat["chat.py<br/>#5"]
                v_voice["voice.py<br/>#6"]
                v_match["job_match.py<br/>#8"]
            end
            comps["components.py<br/>kpi_cards, chat_window"]
            client["api_client.py + constants.py<br/>alla HTTP-anrop, API_URL"]
            app --> views
            views --> comps
            views --> client
        end

        subgraph be["backend/ : cvoice_backend, FastAPI :8000"]
            direction TB
            api["api.py<br/>alla endpoints + Logfire-setup"]
            ingest["ingestion.py<br/>#3 PDF till text, delar i bitar"]
            subgraph agents["agents/"]
                a_prof["profile_agent.py<br/>#4 output: Profile"]
                a_pers["persona_agent.py<br/>#5 verktyg: search_my_documents"]
                a_match["match_agent.py<br/>#8 output: MatchResult"]
            end
            voicef["voice.py<br/>#6 tal till text, text till tal"]
            vstore["vector_store.py<br/>#3 lägg till, #5 sök"]
            shared["model.py, prompts.py #9<br/>data_models.py, constants.py"]
            lancedb[("knowledge_base/<br/>LanceDB")]

            api --> ingest
            ingest --> a_prof
            ingest --> vstore
            api --> a_pers
            a_pers -->|"söker bara i rätt profil"| vstore
            api --> a_match
            a_match --> vstore
            api --> voicef
            vstore --> lancedb
            agents -.-> shared
        end
    end

    subgraph evalsbox["backend/evals/ #10"]
        datasets["datasets/<br/>persona + injection"]
        run_evals["run_evals.py<br/>Pydantic Evals + LLMJudge"]
        datasets --> run_evals
    end

    subgraph ext["Externa tjänster"]
        nvidia["Nvidia Build<br/>språkmodell"]
        embapi["Embedding-API<br/>Cohere multilingual"]
        speech["Tal-API #6<br/>väljs senare"]
        logfire["Logfire #9<br/>traces, promptversioner, evals"]
