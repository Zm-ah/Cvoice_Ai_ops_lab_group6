    subgraph legend["Ansvar"]
        direction LR
        L1["Zakaria"]
        L2["Person B"]
        L3["Person C"]
        L4["Person D"]
    end

    user --> app
    client -->|"HTTP: JSON och filer"| api
    shared --> nvidia
    vstore --> embapi
    voicef --> speech
    api -.->|"traces"| logfire
    shared -.->|"hämtar prompter"| logfire
    run_evals --> a_pers
    run_evals -->|"LLMJudge"| nvidia
    run_evals -.->|"resultat"| logfire
    ci -.-> run_evals
    cd --> acr
    acr --> runtime

