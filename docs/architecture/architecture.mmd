flowchart TB
    user(["Användare<br/>laddar upp CV, chattar, pratar"])

    subgraph gh["GitHub"]
        direction LR
        kanban["Kanban<br/>issues #1 till #14"]
        repo["Repo<br/>main + feature-branches"]
        ci["Actions: CI #11<br/>ruff + pytest + evals"]
        cd["Actions: CD #12<br/>bygg och driftsätt"]
        kanban -.-> repo
        repo --> ci --> cd
    end

    acr[("Azure Container Registry #12")]

